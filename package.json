{
  "name": "dsh-nga-sidebar",
  "version": "0.1.0",
  "description": "DSH WebUI 侧栏 NGA 论坛插件：板块列表 + 帖子列表，经宿主代理抓取，零 CORS 问题",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/verify-artifacts.mjs pre && node node_modules/typescript/bin/tsc -p tsconfig.json && node node_modules/tsdown/dist/run.mjs --config tsdown.config.ts && node scripts/verify-artifacts.mjs post",
    "typecheck": "node node_modules/typescript/bin/tsc -p tsconfig.json --noEmit"
  },
  "license": "BSD-3-Clause",
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.4",
    "@deepseek-ai/dsh-client-runtime": "^0.0.1-rc.5",
    "@deepseek-ai/dsh-host-webserver": "^0.0.1-rc.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-runtime": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-client-runtime": "0.1.1-rc.2",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.7",
    "react": "^18.2.0",
    "react-dom": "^18.3.1",
    "tsdown": "^0.22.0",
    "typescript": "^6.0.0"
  }
}
